{
  "name": "auto-detect-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Keeps Claude Code Remote Control reachable from your iPhone: finds sessions on this PC, reconnects them, and alerts you.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "start:bg": "node src/main.ts --background",
    "stop": "node src/main.ts stop",
    "pair": "node src/main.ts pair",
    "status": "node src/main.ts status",
    "dev": "node --env-file=scripts/dev.env src/main.ts",
    "dev:status": "node --env-file=scripts/dev.env src/main.ts status",
    "build": "node scripts/build.ts",
    "check": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "e2e": "node test/e2e/e2e.mjs",
    "e2e:exe": "node test/e2e/e2e.mjs --exe",
    "icons": "node scripts/make-icons.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^3.1.0",
    "typescript": "^7.0.2"
  }
}
